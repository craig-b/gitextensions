    <Compile Remove="GitUI\ComboBoxExtensions.cs" />
    <Compile Remove="GitUI\ControlDpiExtensions.cs" />
    <Compile Remove="GitUI\ControlHotkeyExtensions.cs" />
    <Compile Remove="GitUI\ControlTagExtensions.cs" />
    <Compile Remove="GitUI\ControlThreadingExtensions.cs" />
    <Compile Remove="GitUI\ControlUtil.cs" />
    <Compile Remove="GitUI\DpiUtil.cs" />
    <Compile Remove="GitUI\HighDpiMouseCursors.cs" />
    <Compile Remove="GitUI\ImageListExtensions.cs" />
    <Compile Remove="GitUI\IMenuItemBackgroundFilter.cs" />
    <Compile Remove="GitUI\ListViewExtensions.cs" />
    <Compile Remove="GitUI\PropertyGridExtensions.cs" />
    <Compile Remove="GitUI\TableLayoutPanelExtensions.cs" />
    <Compile Remove="GitUI\ToolStripExProfessionalRenderer.cs" />
    <Compile Remove="GitUI\ToolStripExSystemRenderer.cs" />
    <Compile Remove="GitUI\ToolStripExtensions.cs" />
    <Compile Remove="GitUI\ToolStripUtil.cs" />
    <Compile Remove="GitUI\Theming\BmpTransformation.cs" />
    <Compile Remove="GitUI\Theming\BrushScope.cs" />
    <Compile Remove="GitUI\Theming\LightnessCorrection.cs" />
    <Compile Remove="GitUI\Theming\TabControlPaintContext.cs" />
    <Compile Remove="GitUI\Theming\TabControlRenderer.cs" />
    <Compile Remove="GitUI\Theming\ThemeFix.cs" />
    <Compile Remove="GitUI\Theming\ThemeWinFormsExtensions.cs" />
    <Compile Remove="GitUI\Interops\COMBOBOXINFO.cs" />
    <Compile Remove="GitUI\Interops\User32\GetComboBoxInfo.cs" />
  </ItemGroup>

</Project>
