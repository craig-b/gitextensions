  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitExtensions.Extensibility\GitExtensions.Extensibility.csproj" />
  </ItemGroup>

  <!-- The net10.0 flavor drops the Windows-only files; the probe's Remove list is the
       authority (eng/portability/PortabilityProbe.csproj), this mirrors it. -->
