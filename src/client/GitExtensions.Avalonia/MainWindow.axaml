<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Avalonia.MainWindow"
        Title="Git Extensions"
        Width="1400" Height="900">
    <Grid ColumnDefinitions="420,4,*">

        <ListBox x:Name="RevisionList" Grid.Column="0" SelectionChanged="OnRevisionSelected" />

        <GridSplitter Grid.Column="1" Background="#40808080" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,4,*" Margin="8,4,4,4">

            <ScrollViewer Grid.Row="0" MaxHeight="320" HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <SelectableTextBlock x:Name="CommitHeader" FontFamily="monospace" FontSize="13" />
                    <SelectableTextBlock x:Name="CommitBody" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Background="#40808080" ResizeDirection="Rows" />

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="DiffText" FontFamily="monospace" FontSize="12.5" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
