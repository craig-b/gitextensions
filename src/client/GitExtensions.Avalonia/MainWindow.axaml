<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitExtensions.Avalonia"
        xmlns:lp="using:GitCommands.LeftPanel"
        x:Class="GitExtensions.Avalonia.MainWindow"
        Title="Git Extensions"
        Width="1500" Height="950">
    <Grid ColumnDefinitions="210,4,*,4,520" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8" Margin="8,6">
            <Button x:Name="CommitToolButton" Content="Commit..." Click="OnOpenCommitClick" />
            <Button x:Name="FetchButton" Content="Fetch" Click="OnFetchClick" />
            <Button x:Name="PullButton" Content="Pull" Click="OnPullClick" />
            <Button x:Name="PushButton" Content="Push" Click="OnPushClick" />
            <Button x:Name="NewBranchButton" Content="New branch..." Click="OnNewBranchClick" />
            <Button x:Name="RemotesButton" Content="Remotes..." Click="OnRemotesClick" />
            <Button x:Name="SettingsButton" Content="Settings..." Click="OnSettingsClick" />
            <TextBlock x:Name="BranchInfo" VerticalAlignment="Center" FontSize="12" Foreground="Gray" Margin="8,0,0,0" />
            <TextBlock x:Name="OperationStatus" VerticalAlignment="Center" FontSize="12" Foreground="Gray" />
        </StackPanel>

        <TreeView x:Name="RefTree" Grid.Column="0" Grid.Row="1" SelectionChanged="OnRefTreeSelectionChanged" DoubleTapped="OnRefTreeDoubleTapped">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="lp:RefTreeNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" FontSize="12" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1" Grid.Row="1" Background="#40808080" ResizeDirection="Columns" />

        <ScrollViewer Grid.Column="2" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <local:RevisionLogControl x:Name="LogControl" />
        </ScrollViewer>

        <GridSplitter Grid.Column="3" Grid.Row="1" Background="#40808080" ResizeDirection="Columns" />

        <Grid Grid.Column="4" Grid.Row="1" RowDefinitions="Auto,4,*" Margin="8,4,4,4">

            <ScrollViewer Grid.Row="0" MaxHeight="340" HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <SelectableTextBlock x:Name="CommitHeader" FontFamily="monospace" FontSize="13" />
                    <SelectableTextBlock x:Name="CommitBody" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Background="#40808080" ResizeDirection="Rows" />

            <Grid Grid.Row="2" ColumnDefinitions="230,4,*">
                <TreeView x:Name="FileTree" Grid.Column="0" SelectionChanged="OnFileTreeSelectionChanged">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="local:StatusNode" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Text}" FontSize="12" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Column="1" Background="#40808080" ResizeDirection="Columns" />

                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal">
                        <SelectableTextBlock x:Name="DiffGutter" FontFamily="monospace" FontSize="12.5" Foreground="Gray" Margin="0,0,10,0" />
                        <SelectableTextBlock x:Name="DiffText" FontFamily="monospace" FontSize="12.5" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
